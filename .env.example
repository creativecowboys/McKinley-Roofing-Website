# McKinley Roofing — lead capture pipeline (app/api/lead)
# Copy to .env.local and fill in. Both channels are optional: if a channel's
# vars are missing it is skipped gracefully and the form still returns success.

# --- Resend email notifications ---
# API key from https://resend.com (Settings > API Keys)
RESEND_API_KEY=
# From address — the sending domain must be verified in Resend.
LEAD_FROM_EMAIL="McKinley Roofing <leads@mail.mckinleyroofing.net>"
# Who receives new-lead notifications (comma-separated for multiple).
LEAD_NOTIFY_EMAIL=mckinleyrandr@gmail.com

# --- GoHighLevel (LeadConnector) API v2 ---
# Private Integration token. Required scopes:
#   contacts.write, opportunities.write, opportunities.readonly
GHL_API_TOKEN=
# Sub-account / location id the contacts + opportunities belong to.
GHL_LOCATION_ID=
# Pipeline to open the opportunity in. If unset, the first pipeline is used.
GHL_PIPELINE_ID=
# Stage name within that pipeline (case-insensitive). Falls back to the first
# stage if not found. Defaults to "New Lead" when unset.
GHL_STAGE_NAME=New Lead
